# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/vitamend?retryWrites=true&w=majority

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_strong_secret_key_here

# Google Gemini (get key from aistudio.google.com)
GEMINI_API_KEY=your_real_key_here
GEMINI_MODEL=gemini-2.5-flash

# Upstash Redis (required for rate limiting — free tier works)
UPSTASH_REDIS_REST_URL=your_upstash_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
