# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/vitamend?retryWrites=true&w=majority
MONGODB_DB_NAME=vitamend

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_strong_random_secret

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Upstash Redis (Rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email notifications (optional)
RESEND_API_KEY=

# Twilio webhook verification (optional)
TWILIO_AUTH_TOKEN=

# Vercel Blob uploads (required when using the hosted upload path)
BLOB_READ_WRITE_TOKEN=

# Vercel Analytics & Speed Insights (Optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
